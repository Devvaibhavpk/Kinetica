# Environments & Secrets
.env
.env.*
.env*.local
*.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Distribution Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
.dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Node & Next.js Build Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.npm/

# IDEs, OS & Editor Caches
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
~$*

# Logs & Local Databases
*.log
*.sqlite3

# Datasets, Weights & Heavy ML Checkpoints
data/*.csv
data/*.json
data/*.mp4
data/*.avi
data/dataset_*/
data/**/*.yaml
data/**/*.jpg
data/**/*.png
data/*.zip
data/raw/
data/kinetica_dataset/
data/videos/
weights/
runs_kinetica/
runs/
*.pt
*.onnx

# Allow Essential Tracked Schemas & Generator Under data/
!data/DATASET_SOURCE.md
!data/synthetic_generator.py
!data/calibration/

# Testing, Coverage & Hypothesis
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
