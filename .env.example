# Kinetica Environment Configuration
# Copy this file to .env and fill in the actual values.

# Database / Storage (if applicable)
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASS=secret

# Vision Module Configuration
CAMERA_RTSP_STREAM_URL=rtsp://user:pass@192.168.1.100:554/stream

# Analytics Module (Optional Weights / Config Paths)
YOLO_WEIGHTS_PATH=./models/yolov8n.pt

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
